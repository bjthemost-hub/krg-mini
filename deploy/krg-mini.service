[Unit]
Description=krg-mini: export this node's task table (SSI building block)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-/sbin/rmmod krg_taskview
ExecStartPre=/sbin/modprobe krg_taskview
ExecStartPre=-/sbin/rmmod krg_dsm
ExecStartPre=-/sbin/modprobe krg_dsm
ExecStart=/usr/local/bin/krgtool serve 7700
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
